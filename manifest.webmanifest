{
  "id": "/cadview-studio/",
  "name": "CADVIEW Studio – 3D CAD Viewer",
  "short_name": "CADVIEW",
  "description": "STEP, IGES, GLB, STL und OBJ im installierbaren 3D-CAD-Viewer bearbeiten, messen, gruppieren und exportieren.",
  "lang": "de",
  "start_url": "/cadview-studio/",
  "scope": "/cadview-studio/",
  "display": "standalone",
  "background_color": "#121A18",
  "theme_color": "#121A18",
  "orientation": "any",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/cadview-studio/",
      "name": "CADVIEW Studio – 3D-CAD-Datei öffnen",
      "accept": {
        "model/step": [
          ".stp",
          ".step"
        ],
        "model/iges": [
          ".igs",
          ".iges"
        ],
        "model/stl": [
          ".stl"
        ],
        "model/obj": [
          ".obj"
        ],
        "model/gltf-binary": [
          ".glb"
        ],
        "model/gltf+json": [
          ".gltf"
        ],
        "application/octet-stream": [
          ".brep"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
